DATABASE_URL=postgresql://postgres:postgres@172.19.232.189:5432/call_voice_agent

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRE_MINUTES=720

VAPI_API_KEY=your-vapi-private-key
VAPI_PUBLIC_KEY=your-vapi-public-key
# Optional: use a saved dashboard assistant for all calls instead of the inline one
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=your-phone-number-id
VAPI_WEBHOOK_SECRET=any-random-string
VAPI_SERVER_URL=https://your-public-domain/api/webhooks/vapi

# Calling now runs on LiveKit + OpenAI Realtime + Twilio SIP (not Vapi). See README
# for how each of these is obtained.
OPENAI_API_KEY=sk-proj-your-openai-key
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# Filled in automatically by `python -m app.twilio_setup` — leave blank until then.
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_AGENT_NAME=nit-reactivation-agent

# Only needed once, to run `python -m app.twilio_setup` (provisions the outbound
# SIP trunk). Not read at normal app runtime.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_TRUNK_DOMAIN=your-trunk-name.pstn.twilio.com

CRM_WEBHOOK_URL=

CALLING_START_HOUR=10
CALLING_END_HOUR=19
MAX_CONCURRENT_CALLS=5
MAX_RETRIES=3
RETRY_GAP_HOURS=3
TIMEZONE=Asia/Karachi
QA_SAMPLE_RATE=0.05
